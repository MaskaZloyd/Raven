@PACKAGE_INIT@

set_and_check(raven_LICENSE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/raven")
set(raven_VULKAN_ENABLED "@RAVEN_BACKEND_VULKAN@")

include(CMakeFindDependencyMacro)
if(NOT WIN32)
	set(THREADS_PREFER_PTHREAD_FLAG ON)
	find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ravenTargets.cmake")

check_required_components(raven)
